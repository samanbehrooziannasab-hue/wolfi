# ─────────────────────────────────────────────────────────────────────────────
# Trading Wolf AI — Environment variables (VPS deployment)
# Copy this file to `.env` on the server and fill in your real values.
# NEVER commit `.env`. All secrets are also manageable from the Admin panel
# (Settings tab) at runtime — the values here are the bootstrap seed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend build mode (baked at BUILD time — Vite) ─────────────────────────
# The app runs in ONE of two modes:
#   VITE_BACKEND=rest    → self-hosted backend (server/, PostgreSQL+Redis).
#                          NO Convex anywhere — recommended for the VPS.
#   VITE_BACKEND=convex  → the Convex backend (Freebuff preview / live app).
#                          Omit the variable (or set it) for that mode.
VITE_BACKEND=rest
# Base URL of the self-hosted API. The bundled nginx config proxies
# /api → 127.0.0.1:3001, so the default works behind nginx.
VITE_API_URL=/api

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_NAME=Trading Wolf AI
APP_PORT=3001                    # backend API + websocket port (behind nginx)
APP_DOMAIN=trading-wolf.example.com
APP_URL=https://trading-wolf.example.com

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Docker Compose uses this same password for the postgres container.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgres://wolf:CHANGE_ME_STRONG_PASSWORD@localhost:5432/wolf_trading
DB_POOL_SIZE=10

# ── Cache / Queue / Rate limit (Redis) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────────────────────────────
# 32+ byte random string:  openssl rand -hex 32
APP_SECRET=CHANGE_ME_openssl_rand_hex_32
# Used to encrypt exchange API keys + AI keys at rest (AES-256-GCM)
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
# CORS: comma separated origins allowed to call the API
CORS_ORIGINS=https://trading-wolf.example.com

# ── Telegram (bot runtime) ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=CHANGE_ME_bot_token_from_BotFather
TELEGRAM_BOT_USERNAME=your_wolf_bot
TELEGRAM_ADMIN_ID=123456789            # numeric owner ID
TELEGRAM_ASSISTANT_ID=                 # optional
TELEGRAM_CHANNEL_ID=-1001234567890     # numeric channel ID
TELEGRAM_CHANNEL_USERNAME=your_channel
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
TELEGRAM_MINI_APP_URL=https://trading-wolf.example.com

# ── AI providers (primary + fallback) ────────────────────────────────────────
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-latest
AI_KEY=
AI_PROVIDER_2=openai
AI_MODEL_2=gpt-4o-mini
AI_KEY_2=
AI_ENABLED=true

# ── SwapWallet (OTC wallet + price feed) ────────────────────────────────────
# Optional — used by the Admin → SwapWallet panel for balances, swaps and
# withdrawals. If left empty you can still paste the key inside the panel
# (stored encrypted in the settings store).
SWAPWALLET_API_KEY=

# ── USDT accounting ──────────────────────────────────────────────────────────
USDT_RATE=1.0
USDT_NETWORK=TRC20

# ── Engine (startup defaults; all editable from Admin panel) ─────────────────
ENGINE_MODE=demo                  # demo | live  (live requires admin activation)
ENGINE_CAPITAL=1000               # virtual capital the engine manages
ENGINE_AUTONOMOUS=true
RISK_MIN_SCORE=80
RISK_MIN_CONFIDENCE=0.5
RISK_RISK_PER_TRADE=1.5
RISK_MAX_LEVERAGE=20
